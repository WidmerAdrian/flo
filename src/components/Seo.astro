---
// What search engines and messengers read about a page: title, description, canonical address,
// link preview (Open Graph, Twitter), icons. Absolute URLs come from `site` in astro.config.mjs.
const { title, description, path = "/", noindex = false } = Astro.props;
const url = new URL(path, Astro.site).href, image = new URL("og.jpg", Astro.site).href;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="de_CH" />
<meta property="og:site_name" content="Therapiezentrum Strähl" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Therapiezentrum Strähl: Loslassen. Medizinische Massage in Oftringen." />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<link rel="icon" type="image/png" sizes="48x48" href="favicon-48.png" />
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png" />
<link rel="apple-touch-icon" href="apple-touch-icon.png" />
<link rel="manifest" href="site.webmanifest" />
<meta name="apple-mobile-web-app-title" content="Strähl" />
